# Godot 4 工程缓存
.godot/

# 便携版 Godot 解压目录（单个 exe 155MB 超 GitHub 100MB 限制；仓库保留 tools/godot.zip）
/tools/godot/

# 网页导出产物（可用 Godot 重新导出，或按需单独发布）
/build/
# Godot Web 导出构建文件（体积大、可由导出流程再生成，不入库）
/index.wasm
/index.pck

# Godot 导入缓存与二进制资产
*.import
*.glb

# 日志与临时文件
*.log
*.tmp
*.bak

# Python 缓存（gdcheck 等工具）
__pycache__/
*.pyc
*.pyd

# 大型发行资产（改入 GitHub Release 分发，不入仓库）
*.zip
/tools/godot/
